{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "stockping",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "stockping-db",
      "database_id": "e4a8b60f-3d7f-4e45-a0ce-a6680d9f127f"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "VAPID_SUBJECT": "https://stockping.app.davidyili230.workers.dev",
    "CHECK_INTERVAL_MS": "300000",
    "VAPID_PRIVATE_KEY": "I_xn9XortqSo4XLt6mJArCv6LVQaTyvQv4woscK5h64",
    "VAPID_PUBLIC_KEY": "BP9B3YpeUrG4LIIL3u_LYLEhibDEna9C2Z4U90nFi8l1OM9iNwGldIZe4lafICUxSuKULYYFrh8gxeLisR572rM"
  }
}
